{
  "name": "dsh-plugin-market-internal",
  "version": "0.1.3",
  "type": "module",
  "description": "Self-hosted plugin marketplace for DeepSeek Harness: a DSH client bundle plus the market server under server/ (accounts, groups, permissions, artifact storage, install statistics).",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "marketplace",
    "self-hosted"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "main": "lib/bundle.js",
  "exports": {
    ".": {
      "default": "./lib/bundle.js"
    },
    "./plugin": {
      "default": "./lib/plugin.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/bundle.js",
    "lib/plugin.js",
    "lib/client.js",
    "lib/tar.js",
    "web/market.html",
    "web/market.css",
    "web/shared.js",
    "server/lib/version.js",
    "server/lib/layout.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    },
    "market": {
      "displayName": "内部插件市场",
      "summary": "浏览、安装、管理内部 DSH 插件",
      "owner": "platform",
      "visibility": "company"
    }
  }
}
