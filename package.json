{
  "name": "dsh-plugin-marketplace",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "DSH internal plugin marketplace client: a profile bundle whose patch layer inserts the host plugin that serves /market and installs authorized plugins into this profile. Accounts, permissions and the catalog live in the standalone market service under server/.",
  "main": "lib/bundle.js",
  "exports": {
    ".": {
      "default": "./lib/bundle.js"
    },
    "./plugin": {
      "default": "./lib/plugin.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/bundle.js",
    "lib/plugin.js",
    "lib/client.js",
    "lib/tar.js",
    "web/market.html",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    },
    "market": {
      "displayName": "内部插件市场",
      "summary": "浏览、安装、管理内部 DSH 插件",
      "owner": "platform",
      "visibility": "company"
    }
  }
}
